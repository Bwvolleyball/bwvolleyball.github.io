---
import { LINKEDIN } from '../lib/brand';

type Props = { linkedin?: string; year?: number };
const { linkedin = LINKEDIN, year = new Date().getFullYear() } = Astro.props;
---

<footer class="bw-foot">
	<span>© {year} Brandon Ward</span>
	<a href={linkedin} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span><span class="bw-sr"> (opens in a new tab)</span></a>
</footer>
