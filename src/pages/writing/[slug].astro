---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryMeta from '../../components/EntryMeta.astro';
import Prose from '../../components/Prose.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';
import { getLocalPosts } from '../../lib/content';

export async function getStaticPaths() {
	const posts = await getLocalPosts();
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const entry = { ...post.data, date: post.data.published, href: `/writing/${post.id}` };
---

<BaseLayout title={`${entry.title} | Brandon Ward`} description={entry.summary} current="writing">
	<article class="bw-article">
		<a class="bw-quiet" href="/writing">← All writing</a>
		<div class="bw-article-head">
			<EntryMeta entry={entry} />
			<h1 class="bw-page-title">{entry.title}</h1>
			{entry.summary && <p class="bw-page-sub">{entry.summary}</p>}
			{
				entry.original && (
					<p class="bw-article-orig">
						First published on the <a href={entry.original.url}>{entry.original.publisher}</a>.
					</p>
				)
			}
		</div>
		<Prose>
			<Content />
		</Prose>
	</article>
	<ClosingCTA />
</BaseLayout>
