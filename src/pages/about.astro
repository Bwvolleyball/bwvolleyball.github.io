---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Prose from '../components/Prose.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TimelineRow from '../components/TimelineRow.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { getTimeline } from '../lib/content';

const bio = await getEntry('about', 'bio');
if (!bio) throw new Error('Missing src/content/about/bio.md');
const { Content } = await render(bio);
const timeline = await getTimeline();
---

<BaseLayout title="About | Brandon Ward" description="Brandon Ward: Product Architect for Vanguard Personalized Indexing, and the full career timeline." current="about">
	<div>
		<PageHead title="About" />
		{bio.data.draft && <p class="bw-mono bw-draft">Draft · for Brandon to edit</p>}
	</div>
	<section class="bw-page-sec bw-page-sec-tight">
		<Prose>
			<Content />
		</Prose>
	</section>
	<section class="bw-page-sec">
		<SectionHeader title="Career" />
		<ol class="bw-tl-list">
			{timeline.map((t) => <TimelineRow {...t} />)}
		</ol>
	</section>
	<ClosingCTA />
</BaseLayout>
