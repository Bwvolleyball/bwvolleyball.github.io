---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Prose from '../components/Prose.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TimelineRow from '../components/TimelineRow.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { getTimeline } from '../lib/content';
import resume from '../content/resume.json';
import headshot from '../assets/brandon-ward-headshot.jpg';

const bio = await getEntry('about', 'bio');
if (!bio) throw new Error('Missing src/content/about/bio.md');
const { Content } = await render(bio);
const timeline = await getTimeline();
---

<BaseLayout title="About | Brandon Ward" description="Brandon Ward: Product Architect for Vanguard Personalized Indexing. The full resume: every role, education, honors, certifications, and volunteering." current="about">
	<div>
		<PageHead title="About" />
		{bio.data.draft && <p class="bw-mono bw-draft">Draft · for Brandon to edit</p>}
	</div>
	<section class="bw-page-sec bw-page-sec-tight bw-about-intro">
		<Image class="bw-about-photo" src={headshot} alt="Brandon Ward" widths={[240, 360, 480, 720]} sizes="(max-width: 720px) 160px, 240px" format="webp" loading="eager" />
		<Prose>
			<Content />
		</Prose>
	</section>
	<section class="bw-page-sec">
		<SectionHeader title="Career" />
		<ol class="bw-tl-list">
			{timeline.map((t) => <TimelineRow {...t} />)}
		</ol>
	</section>
	<section class="bw-page-sec">
		<SectionHeader title="Education" />
		<ol class="bw-tl-list">
			{resume.education.map((e) => <TimelineRow when={`${e.start} – ${e.end}`} role={e.degree} company={e.school} note={e.note} />)}
		</ol>
	</section>
	<section class="bw-page-sec">
		<SectionHeader title="Honors and awards" />
		<ol class="bw-tl-list">
			{resume.honors.map((h) => <TimelineRow when={h.date ?? ''} role={h.title} company={h.issuer} note={h.note} />)}
		</ol>
	</section>
	<section class="bw-page-sec">
		<SectionHeader title="Certifications" />
		<ol class="bw-tl-list">
			{resume.certifications.map((c) => <TimelineRow when={c.date} role={c.title} company={c.issuer} />)}
		</ol>
	</section>
	<section class="bw-page-sec">
		<SectionHeader title="Volunteering" />
		<ol class="bw-tl-list">
			{resume.volunteering.map((v) => <TimelineRow when={`${v.start} – ${v.end}`} role={v.role} company={v.org} note={v.cause} points={v.points} links={v.links} />)}
		</ol>
	</section>
	<ClosingCTA />
</BaseLayout>
