---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import WritingList from '../components/WritingList.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { getCards, getWriting } from '../lib/content';
import { splitFeatured } from '../lib/brand';

const cards = await getCards();
const { featured, rest } = splitFeatured(await getWriting());
const newestThree = featured ? [featured, ...rest].slice(0, 3) : [];
---

<BaseLayout>
	<Hero />
	<section class="bw-page-sec">
		<SectionHeader number="01" title="Experience">
			<a slot="aside" class="bw-quiet" href="/about">Full timeline →</a>
		</SectionHeader>
		<div class="bw-xp-stack">
			{cards.map((c) => <ExperienceCard {...c} />)}
		</div>
	</section>
	<section class="bw-page-sec">
		<SectionHeader number="02" title="Writing">
			<a slot="aside" class="bw-quiet" href="/writing">Cloud · Mobile · Architecture →</a>
		</SectionHeader>
		<WritingList entries={newestThree} />
	</section>
	<ClosingCTA />
</BaseLayout>
